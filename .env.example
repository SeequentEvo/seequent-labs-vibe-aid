# Seequent Evo API Configuration
# Copy this file to .env and fill in your values.
# Override locally via .env.local (gitignored by Vite).
# For deployed builds, set these via process.env in CI.

# Bentley IMS (identity provider)
VITE_IMS_BASE_URL=https://ims.bentley.com
VITE_IMS_CLIENT_ID=
VITE_IMS_SCOPES="evo.discovery evo.workspace evo.object evo.file evo.blocksync"

# Evo Discovery API (entrypoint that resolves instances + hub URLs)
VITE_EVO_DISCOVERY_BASE_URL=https://discover.api.seequent.com
