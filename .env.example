# Seequent Evo API Configuration
# Copy this file to .env and fill in your values.
# Override locally via .env.local (gitignored by Vite).
# For deployed builds, set these via process.env in CI.
#
# All VITE_* variables are compiled into public browser JavaScript.
# Never place private API keys, client secrets, or privileged credentials here.

# Bentley IMS (identity provider)
VITE_IMS_BASE_URL=https://ims.bentley.com
VITE_IMS_CLIENT_ID=
# Minimum scopes for discovery and workspace selection. Add evo.object, evo.file,
# or evo.blocksync only for features that require those APIs.
VITE_IMS_SCOPES="evo.discovery evo.workspace"

# Evo Discovery API (entrypoint that resolves instances + hub URLs)
VITE_EVO_DISCOVERY_BASE_URL=https://discover.api.seequent.com
